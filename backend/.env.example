PORT=8080
POSTGREST_URL=http://postgrest:3000
# At least 32 random bytes, shared with PostgREST (PGRST_JWT_SECRET) and the frontend server.
JWT_SECRET=replace_with_at_least_32_random_bytes_secret
# Optional comma-separated list. Leave empty: the frontend proxies to the backend server-side.
CORS_ALLOWED_ORIGINS=
# Shared secret for POST /api/v1/internal/notifications/generate (header X-Deku-Cron-Secret).
# Leave empty to disable the endpoint (it then returns 404).
CRON_SECRET=
# Base64 of 32 random bytes (openssl rand -base64 32). Encrypts third-party credentials; unset = integrations off.
DATA_ENCRYPTION_KEY=
