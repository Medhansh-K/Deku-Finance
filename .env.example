# Local development values (docker compose reads them from .env; these are also its defaults).
# Never reuse them anywhere real: in GCP every secret lives in Secret Manager (deploy/gcp/README.md).
POSTGRES_PASSWORD=dev-only-postgres-password
AUTHENTICATOR_PASSWORD=dev-only-authenticator-password
# At least 32 random bytes in real deployments: openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# Used when running `npm run dev` outside compose (compose sets http://backend:8080)
BACKEND_URL=http://localhost:8080
# Shared secret for the backend's internal notification job (header X-Deku-Cron-Secret)
CRON_SECRET=dev-only-cron-secret
# Dev-only key (base64 of 32 bytes). Generate a real one with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=ZGV2LW9ubHktZGF0YS1lbmNyeXB0aW9uLWtleS0zMmI=
