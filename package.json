{
  "name": "deku-finance-monorepo",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@deku/platform",
    "dev:platform": "npm run dev --workspace=@deku/platform",
    "dev:admin": "npm run dev --workspace=@deku/admin",
    "dev:distributor": "npm run dev --workspace=@deku/distributor",
    "build": "npm run build --workspaces",
    "build:platform": "npm run build --workspace=@deku/platform",
    "build:admin": "npm run build --workspace=@deku/admin",
    "build:distributor": "npm run build --workspace=@deku/distributor",
    "start": "npm run start --workspace=@deku/platform",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
