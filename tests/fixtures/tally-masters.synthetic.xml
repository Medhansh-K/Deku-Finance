        <TALLYMESSAGE xmlns:UDF="TallyUDF">
          <LEDGER NAME="Beta Supplies" ACTION="Create">
            <PARENT>Sundry Creditors</PARENT>
            <OPENINGBALANCE>9999.50</OPENINGBALANCE>
