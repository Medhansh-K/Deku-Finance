          <GROUP NAME="Partners Drawings" ACTION="Create">
            <PARENT>&#4; Primary</PARENT>
          </GROUP>
        </TALLYMESSAGE>
        <TALLYMESSAGE xmlns:UDF="TallyUDF">
          <LEDGER NAME="Cash" ACTION="Create">
            <NAME.LIST><NAME>Cash</NAME></NAME.LIST>
            <PARENT>Cash-in-Hand</PARENT>
            <OPENINGBALANCE>-25000.00</OPENINGBALANCE>
          </LEDGER>
        </TALLYMESSAGE>
        <TALLYMESSAGE xmlns:UDF="TallyUDF">
          <LEDGER NAME="Synthetic Bank A/c" ACTION="Create">
