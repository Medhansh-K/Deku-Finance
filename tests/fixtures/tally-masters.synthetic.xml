            <OPENINGBALANCE>150000.00</OPENINGBALANCE>
          </LEDGER>
        </TALLYMESSAGE>
        <TALLYMESSAGE xmlns:UDF="TallyUDF">
          <LEDGER NAME="Alpha Retail" ACTION="Create">
            <PARENT>Sundry Debtors</PARENT>
            <OPENINGBALANCE>-15000.00</OPENINGBALANCE>
            <PARTYGSTIN>27AAPFU0939F1ZV</PARTYGSTIN>
            <GSTREGISTRATIONTYPE>Regular</GSTREGISTRATIONTYPE>
            <LEDSTATENAME>Maharashtra</LEDSTATENAME>
            <INCOMETAXNUMBER>AAPFU0939F</INCOMETAXNUMBER>
          </LEDGER>
