          </LEDGER>
        </TALLYMESSAGE>
        <TALLYMESSAGE xmlns:UDF="TallyUDF">
          <LEDGER NAME="Sales @ 18%" ACTION="Create">
            <PARENT>Sales Accounts</PARENT>
          </LEDGER>
        </TALLYMESSAGE>
        <TALLYMESSAGE xmlns:UDF="TallyUDF">
          <LEDGER NAME="Output IGST" ACTION="Create">
            <PARENT>Duties &amp; Taxes</PARENT>
          </LEDGER>
        </TALLYMESSAGE>
        <TALLYMESSAGE xmlns:UDF="TallyUDF">
          <LEDGER NAME="Stationery" ACTION="Create">
            <PARENT>Office Overheads</PARENT>
          </LEDGER>
        </TALLYMESSAGE>
        <TALLYMESSAGE xmlns:UDF="TallyUDF">
          <LEDGER NAME="Drawings - Partner A" ACTION="Create">
            <PARENT>Partners Drawings</PARENT>
            <OPENINGBALANCE>-500.00</OPENINGBALANCE>
          </LEDGER>
        </TALLYMESSAGE>
        <TALLYMESSAGE xmlns:UDF="TallyUDF">
          <STOCKITEM NAME="Synthetic Widget" ACTION="Create">
            <BASEUNITS>Nos</BASEUNITS>
            <GSTDETAILS.LIST>
              <HSNCODE>84713010</HSNCODE>
            </GSTDETAILS.LIST>
          </STOCKITEM>
        </TALLYMESSAGE>
        <TALLYMESSAGE xmlns:UDF="TallyUDF">
          <STOCKITEM NAME="Synthetic Cable" ACTION="Create">
